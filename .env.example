# =============================================================================
# API KEYS — copy this file to `.env` and fill in your own keys
# =============================================================================

# OpenAI — PDF brief extraction and image classification (gpt-5.2 / gpt-4o)
OPENAI_API_KEY=sk-your-key-here

# Google Gemini — scenario analysis, vision QA, image generation
# GOOGLE_API_KEY is accepted as an alias by the google-genai SDK.
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic — HTML generation and technical QA (Claude Sonnet 4.5)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# FAL.AI — asset image generation (fal-ai/gemini-25-flash-image)
FAL_KEY=your-fal-api-key-here

# =============================================================================
# NOTES
# =============================================================================
#
# Model identifiers are currently pinned in code, not in this file:
#   - services/gemini_client.py       -> gemini-2.5-flash (scenario, vision QA)
#   - services/imagen_client.py       -> gemini-3-pro-image-preview
#   - services/fal_imagen_client.py   -> fal-ai/gemini-25-flash-image
#   - playable_agents/generator_agent.py -> claude-sonnet-4-5
#   - tools/pdf_tools.py, tools/image_tools.py -> gpt-5.2
#
# The QA loop iteration limit is set via PlayableOrchestrator(max_qa_iterations=N).
